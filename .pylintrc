[MASTER]
# Python code to execute, usually for sys.path manipulation such as
# pygtk.require().
#init-hook=

# Use multiple processes to speed up Pylint.
jobs=4

# List of plugins (as comma separated values of python modules names) to load,
# usually to register additional checkers.
load-plugins=pylint.extensions.docparams

# A comma-separated list of package or module names from where C extensions may
# be loaded. Extensions are loading into the active Python interpreter and may
# run arbitrary code
extension-pkg-whitelist=pydantic

# Pickle collected data for later comparisons.
persistent=yes

# Allow loading of arbitrary C extensions. Extensions are imported into the
# active Python interpreter and may run arbitrary code.
unsafe-load-any-extension=no

# Minimum Python version to use for version dependent checks (defaults to minimum supported Python version)
py-version=3.9

ignore=CVS
ignore-patterns=

[MESSAGES CONTROL]
# Set to match the pre-commit hook configuration
fail-on=E
fail-under=7.5

# Disable the following warnings
disable=
    # Too many lines in module
    C0302,
    # Redefined built-in format
    W0622,
    # F-string in logging
    W1203,
    # Unspecified encoding
    W1514,
    # Too many branches
    R0912,
    # Too many statements
    R0915,
    # Reimported
    W0404,
    # Redefining from outer scope
    W0621,
    # Bad continuation indent for multiline imports
    C0330,
    # Hanging indentation is a bad practice
    C0330,
    # Missing module docstring
    C0111

[REPORTS]
# Tells whether to display a full report or only the errors
reports=no
evaluation=10.0 - ((float(5 * error + warning + refactor + convention) / statement) * 10)
score=yes
output-format=text
msg-template={path}:{line}:{column}: {msg_id}: {msg} ({symbol})

[LOGGING]
logging-modules=logging

[FORMAT]
# Google style guide settings
max-line-length=120
indent-string='    '
indent-after-paren=4
expected-line-ending-format=LF

[BASIC]
# Good variable names which should always be accepted
good-names=i,j,k,ex,Run,_,id,e,f,T

[SIMILARITIES]
min-similarity-lines=4
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes

[VARIABLES]
# Google style guide related settings
dummy-variables-rgx=_|dummy|unused|.*_unused
init-import=no

[DESIGN]
# Google style guide influences
max-args=7
max-attributes=10
max-branches=15
max-locals=15
max-returns=6
max-statements=60
max-parents=7
max-attributes=11
min-public-methods=1
max-public-methods=20

[CLASSES]
ignore-mixin-members=yes
defining-attr-methods=__init__,__new__,setUp
valid-classmethod-first-arg=cls
valid-metaclass-classmethod-first-arg=mcs

[IMPORTS]
# Force import order to recognize a module as part of a third party library
known-third-party=enchant
deprecated-modules=regsub,TERMIOS,Bastion,rexec
allow-wildcard-with-all=no

[EXCEPTIONS]
overgeneral-exceptions=Exception

[TYPECHECK]
# List of members which are set dynamically and missed by Pylint inference
# system, and so shouldn't trigger E1101 when accessed
generated-members=
ignored-modules=
ignore-none=yes
ignored-classes=

[DOCSTRING]
# Google style docstring settings
accept-no-param-doc=no
accept-no-raise-doc=no
accept-no-return-doc=no
accept-no-yields-doc=no
default-docstring-type=google
